          "start": 54.89,
          "duration": 1.008
        }
      ]
    },
    {
      "id": "s10",
      "scene": "taste",
      "text": "Toprak limon gibi ekşi, kayısı gibi tatlı, biber gibi acı da değil. Toprak hâl diliyle der: Bunları yapan ben değilim.",
      "start": 56.218,
      "duration": 7.811,
      "captions": [
        {
          "text": "Toprak ne ekşi, ne tatlı,",
          "start": 56.218,
          "duration": 2.441
        },
        {
          "text": "ne de acıdır.",
          "start": 58.658,
          "duration": 1.269
        },
        {
          "text": "Toprak der ki:",
          "start": 59.928,
