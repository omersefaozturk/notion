          "duration": 1.36
        }
      ]
    },
    {
      "id": "s08",
      "scene": "fruits",
      "text": "Meyvelere bakalım. Her birinin rengi, tadı, kokusu farklı. Onları farklı kılan toprak mı?",
      "start": 36.72,
      "duration": 5.16,
      "captions": [
        {
          "text": "Her meyvenin rengi,",
          "start": 36.72,
