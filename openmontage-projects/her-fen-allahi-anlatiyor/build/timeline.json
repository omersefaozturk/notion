    {
      "id": "s13",
      "scene": "stars",
      "text": "Güneşi ve yıldızları yakıtsız yandıran, söndürmeyen, birbirine çarptırmayan bir yaratıcı vardır: Yüce Allah.",
      "start": 77.727,
      "duration": 7.035,
      "captions": [
        {
          "text": "Yıldızları yakıtsız yandıran,",
