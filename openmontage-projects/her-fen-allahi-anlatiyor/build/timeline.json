    },
    {
      "id": "s12",
      "scene": "sun",
      "text": "Güneş de yaratıldığı günden beri yanıyor. Ne gazyağı, ne kömür, ne odun. Enerjisi hiç bitmiyor.",
      "start": 70.974,
      "duration": 6.433,
      "captions": [
        {
          "text": "Güneş, ilk günden beri",
