    },
    {
      "id": "s05",
      "scene": "apple",
      "text": "Kâinattaki her canlı ise daha hassas ölçülerle yaratılmış. Elmanın içi biraz değişse, elma, elma olmaktan çıkar.",
      "start": 17.88,
      "duration": 6.6,
      "captions": [
        {
          "text": "Kâinattaki her canlı",
          "start": 17.88,
          "duration": 1.4
        },
        {
          "text": "çok daha hassas ölçüde.",
          "start": 19.28,
          "duration": 2.0
        },
        {
          "text": "Elmanın içi değişse,",
          "start": 21.28,
