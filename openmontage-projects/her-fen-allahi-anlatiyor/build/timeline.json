        },
        {
          "text": "elma, elma olmaktan çıkar.",
          "start": 22.84,
          "duration": 1.64
        }
      ]
    },
    {
      "id": "s06",
      "scene": "body",
      "text": "İnsan vücudu da hassas bir dengede. Kandaki şeker artınca şeker hastalığı, demir eksilince kansızlık çıkar.",
      "start": 24.8,
      "duration": 6.04,
      "captions": [
        {
          "text": "İnsan vücudu da",
          "start": 24.8,
          "duration": 1.2
