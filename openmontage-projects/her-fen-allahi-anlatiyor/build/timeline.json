    },
    {
      "id": "s09",
      "scene": "soil",
      "text": "Basit bir iğne için bile fabrika, makine, işçi gerekir. Toprağın altında ise fabrika da yok, işçi de.",
      "start": 42.2,
      "duration": 5.88,
