          "start": 52.8,
          "duration": 2.4
        }
      ]
    },
    {
      "id": "s11",
      "scene": "city",
      "text": "Milyonlarca lambası hiç sönmeyen bir şehir düşünün. Böyle bir eser, maharetli bir ustayı gösterir.",
      "start": 55.52,
      "duration": 5.4,
      "captions": [
        {
          "text": "Milyonlarca lambası",
          "start": 55.52,
          "duration": 1.08
