          "start": 47.2,
          "duration": 0.88
        }
      ]
    },
    {
      "id": "s10",
      "scene": "taste",
      "text": "Toprak limon gibi ekşi, kayısı gibi tatlı, biber gibi acı da değil. Toprak hâl diliyle der: Bunları yapan ben değilim.",
      "start": 48.4,
      "duration": 6.8,
      "captions": [
        {
          "text": "Toprak ne ekşi, ne tatlı,",
          "start": 48.4,
          "duration": 2.08
        },
        {
          "text": "ne de acıdır.",
          "start": 50.48,
          "duration": 1.08
        },
        {
          "text": "Toprak der ki:",
