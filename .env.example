# Copy to .env (never commit it) or set these in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Leave empty locally to use the built-in PGlite database (server/data/pglite).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Long random secret for signing login tokens: openssl rand -hex 32  (required in production)
JWT_SECRET=

# Household time zone used when the client does not send one.
APP_TIMEZONE=Europe/Istanbul
